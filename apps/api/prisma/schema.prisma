// ── Barcode / QR ────────────────────────────────────────────────

model BarcodeLabel {
  id                 String    @id @default(cuid())
  // Nullable for backward compatibility. Runtime access is fail-closed: only
  // rows matching the exact active company and branch are exposed.
  companyId          String?
  branchId           String?
  code               String    @unique
  value              String    @unique
  symbology          String    @default("QR_CODE")
  entityType         String
  entityId           String
  status             String    @default("ACTIVE")
  title              String?
  description        String?   @db.NVarChar(Max)
