  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastIssueAt       DateTime?
  lastIssueByUserId String?
  lastIssueBy       User?      @relation("PartStockIssuedBy", fields: [lastIssueByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Batch Y — cost attribution and receiver tracking (all nullable, backward compatible, scalar-only)
  costOwnerType             String?
  costOwnerAdministrationId String?
  costDepartmentId          String?
  costProductionLineId      String?
  costMachineId             String?
  costMachineComponentId    String?
  unitCost                  Decimal?  @db.Decimal(18, 4)
  totalCost                 Decimal?  @db.Decimal(18, 4)
  receivedByUserId          String?
  receivedAt                DateTime?

  // Cost Purpose R1 — canonical "WHY" dimension (nullable additive, backward compatible)
  // MAINTENANCE by default on stock issue; override requires cost-purpose:override + reason.
  costPurpose               String?
  costPurposeOverrideReason String?

  // Batch Y Addendum — part condition, replacement action, removed part tracking
  issuedStockCondition        String?
  replacementAction           String?
  removedPartCondition        String?
  removedPartWarehouseId      String?
  removedPartQuantity         Float?
  removedPartReturnedByUserId String?
  removedPartReceivedByUserId String?
  removedPartReturnedAt       DateTime?
  noReturnReason              String?

  conditionMovements   SparePartConditionMovement[]
  installedParts       MachineInstalledPart[]
  replacementHistories SparePartReplacementHistory[]
  repairOrders         SparePartRepairOrder[]

  @@unique([maintenanceRequestId, sparePartId])
  @@index([maintenanceRequestId])
  @@index([sparePartId])
  @@index([machineComponentId])
  @@index([machineId])
  @@index([status])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([reservedByUserId])
  @@index([usedByUserId])
  @@index([failureCauseId])
  @@index([costOwnerType])
  @@index([costPurpose])
  @@index([costProductionLineId])
  @@index([costMachineId])
  @@index([costMachineComponentId])
  @@index([receivedByUserId])
  @@index([issuedStockCondition])
  @@index([replacementAction])
  @@index([removedPartCondition])
  @@index([removedPartWarehouseId])
  @@map("maintenance_request_required_parts")
}

