  @@index([companyId, branchId, costCenterId, effectiveFrom, effectiveTo])
  @@index([companyId, branchId, productionLineId, machineId, effectiveFrom, effectiveTo])
  @@index([productionLineId])
  @@index([machineId])
  @@index([costCenterId])
  @@map("operational_cost_rates")
}

model OperationalStandardCostSnapshot {
  id                            String                      @id @default(cuid())
  companyId                     String
  company                       Company                     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId                      String
  branch                        Branch                      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                          String
  revision                      Int                         @default(1)
  productionProductDefinitionId String
  productionProductDefinition   ProductionProductDefinition @relation(fields: [productionProductDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionVersionId           String?
  productionVersion             ProductionVersion?          @relation(fields: [productionVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionPackagingId         String?
  productionPackaging           ProductionPackaging?        @relation(fields: [productionPackagingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId              String?
  productionLine                ProductionLine?             @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineId                     String?
  machine                       Machine?                    @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costCenterId                  String?
  costCenter                    CostCenter?                 @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costType                      String
  unit                          String
  quantity                      Decimal                     @db.Decimal(18, 4)
  rate                          Decimal                     @db.Decimal(19, 4)
  amount                        Decimal                     @db.Decimal(19, 4)
  currencyCode                  String                      @default("USD")
  effectiveFrom                 DateTime
  effectiveTo                   DateTime?
  status                        String                      @default("DRAFT")
  frozenById                    String?
  frozenAt                      DateTime?
  supersededById                String?
  supersededAt                  DateTime?
  notes                         String?
  createdById                   String
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  deletedAt                     DateTime?

  costTransactions OperationalCostTransaction[]

  @@unique([companyId, branchId, code, revision])
  @@index([companyId, branchId, productionProductDefinitionId, productionVersionId, productionPackagingId, costType, status])
  @@index([companyId, branchId, status, effectiveFrom, effectiveTo])
  @@index([productionProductDefinitionId])
  @@index([productionVersionId])
  @@index([productionPackagingId])
  @@index([productionLineId])
  @@index([machineId])
  @@index([costCenterId])
  @@map("operational_standard_cost_snapshots")
}

model OperationalCostTransaction {
  id                        String                           @id @default(cuid())
  companyId                 String
  company                   Company                          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId                  String
  branch                    Branch                           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventType                 String
  sourceType                String
  sourceId                  String
  sourceNumberSnapshot      String?
  /// Canonical identity of the authoritative source valuation (sourceType:sourceId:eventType).
  /// Set for real operational sources only (never MANUAL/REVERSAL). Non-null uniqueness per
  /// tenant is enforced by a SQL Server filtered unique index in migration 20260806210000;
  /// it prevents the same authoritative source+event from being valued twice.
  sourceFingerprint         String?
  /// Canonical idempotency fingerprint of the request payload that created this row
  /// (same requestId + same payload is a replay; same requestId + different payload
  /// is a conflict). Legacy rows may be NULL and fall back to a stored-field fingerprint.
  requestPayloadFingerprint String?
  clientRequestId           String
  calculationId             String?
  calculation               OperationalCostCalculation?      @relation(fields: [calculationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionOrderId         String?
  productionOrder           ProductionOrder?                 @relation(fields: [productionOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionRunId           String?
  productionRun             ProductionRun?                   @relation(fields: [productionRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId                 String?
  product                   Product?                         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productCodeSnapshot       String?
  productNameSnapshot       String?
  productionVersionId       String?
  productionVersion         ProductionVersion?               @relation(fields: [productionVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionPackagingId     String?
  productionPackaging       ProductionPackaging?             @relation(fields: [productionPackagingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId          String?
  productionLine            ProductionLine?                  @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineId                 String?
  machine                   Machine?                         @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftId                   String?
  shift                     ProductionShift?                 @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costCenterId              String?
  costCenter                CostCenter?                      @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  standardCostSnapshotId    String?
  standardCostSnapshot      OperationalStandardCostSnapshot? @relation(fields: [standardCostSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outputEventId             String?
  outputEvent               ProductionOutputEvent?           @relation(fields: [outputEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity                  Decimal                          @db.Decimal(18, 4)
  unit                      String
  rate                      Decimal                          @db.Decimal(19, 4)
  amount                    Decimal                          @db.Decimal(19, 4)
  currencyCode              String                           @default("USD")
  standardAmount            Decimal?                         @db.Decimal(19, 4)
  varianceAmount            Decimal?                         @db.Decimal(19, 4)
  occurredAt                DateTime
  status                    String                           @default("POSTED")
  reversalOfId              String?
  reversalOf                OperationalCostTransaction?      @relation("OperationalCostReversal", fields: [reversalOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversals                 OperationalCostTransaction[]     @relation("OperationalCostReversal")
  reversalReason            String?
  notes                     String?
  createdById               String
  reversedById              String?
  reversedAt                DateTime?
  createdAt                 DateTime                         @default(now())

  @@unique([companyId, branchId, clientRequestId])
  @@index([companyId, branchId, eventType, occurredAt])
  @@index([companyId, branchId, sourceType, sourceId])
  @@index([companyId, branchId, sourceFingerprint])
  @@index([companyId, branchId, calculationId, occurredAt])
  @@index([companyId, branchId, productionOrderId, occurredAt])
  @@index([companyId, branchId, productionRunId, occurredAt])
  @@index([companyId, branchId, costCenterId, occurredAt])
  @@index([productionOrderId])
  @@index([productionRunId])
  @@index([productId])
  @@index([productionVersionId])
  @@index([productionPackagingId])
  @@index([productionLineId])
  @@index([machineId])
  @@index([shiftId])
  @@index([costCenterId])
  @@index([standardCostSnapshotId])
  @@index([outputEventId])
  @@index([reversalOfId])
  @@map("operational_cost_transactions")
}

// ════ Phase 2 Reversal + Cost + Analytics slice ────────────────────────────────
// Calculation lifecycle (draft → review → finalize → reopen/recalculate). Finalized
// revisions are preserved immutably; the amounts themselves are never duplicated here
// (per Constitution rule 6) — a calculation aggregates its linked atomic transactions.
model OperationalCostCalculation {
  id                String                       @id @default(cuid())
  companyId         String
  company           Company                      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId          String
  branch            Branch                       @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code              String
  revision          Int                          @default(1)
  scopeType         String
  scopeId           String
  productionOrderId String?
  productionOrder   ProductionOrder?             @relation(fields: [productionOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionRunId   String?
  productionRun     ProductionRun?               @relation(fields: [productionRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodFrom        DateTime
  periodTo          DateTime
  status            String                       @default("DRAFT")
  currencyCode      String                       @default("USD")
  reviewedById      String?
  reviewedAt        DateTime?
  finalizedById     String?
  finalizedAt       DateTime?
  supersedesId      String?
  supersedes        OperationalCostCalculation?  @relation("CostCalculationRevision", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions         OperationalCostCalculation[] @relation("CostCalculationRevision")
  reason            String?
  notes             String?
  createdById       String
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  deletedAt         DateTime?

  transactions OperationalCostTransaction[]

  @@unique([companyId, branchId, code, revision])
  @@index([companyId, branchId, scopeType, scopeId, status])
  @@index([companyId, branchId, productionOrderId, periodFrom, periodTo])
  @@index([companyId, branchId, productionRunId, periodFrom, periodTo])
  @@index([supersedesId])
  @@map("operational_cost_calculations")
}

/// Tenant-scoped source-change / invalidation watermark. Recorded deterministically
/// whenever a fact feeding live analytics changes (material-document reversal, cost
/// reversal/correction). Analytics are always computed live from the source tables;
/// this table carries the metadata/warning surfaced on read endpoints.
model OperationalSourceChange {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scopeType  String
  scopeId    String
  entityType String
  entityId   String
  changeType String
  reason     String?
  actorId    String
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([companyId, branchId, scopeType, scopeId, createdAt])
  @@index([companyId, branchId, entityType, entityId])
  @@index([companyId, branchId, changeType, createdAt])
  @@map("operational_source_changes")
}

// ════ Phase 1.9 OEE and Production Analytics ───────────────────────────────────
model ProductionPerformanceTarget {
  id                            String                        @id @default(cuid())
  companyId                     String
  company                       Company                       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId                      String
  branch                        Branch                        @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                          String
  scopeType                     String
  productionUnitId              String?
  productionUnit                ProductionUnit?               @relation(fields: [productionUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId              String?
  productionLine                ProductionLine?               @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineId                     String?
  machine                       Machine?                      @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionProductDefinitionId String?
  productionProductDefinition   ProductionProductDefinition?  @relation(fields: [productionProductDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  effectiveFrom                 DateTime
  effectiveTo                   DateTime?
  availabilityTarget            Decimal                       @db.Decimal(7, 4)
  performanceTarget             Decimal                       @db.Decimal(7, 4)
  qualityTarget                 Decimal                       @db.Decimal(7, 4)
  oeeTarget                     Decimal                       @db.Decimal(7, 4)
  status                        String                        @default("DRAFT")
  revision                      Int                           @default(1)
  supersedesId                  String?
  supersedes                    ProductionPerformanceTarget?  @relation("PerformanceTargetRevision", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions                     ProductionPerformanceTarget[] @relation("PerformanceTargetRevision")
  approvalNote                  String?
  notes                         String?
  createdById                   String
  updatedById                   String
  submittedById                 String?
  submittedAt                   DateTime?
  approvedById                  String?
  approvedAt                    DateTime?
  deactivatedById               String?
  deactivatedAt                 DateTime?
  deactivationReason            String?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  deletedAt                     DateTime?

  transitions ProductionPerformanceTargetTransition[]

  @@unique([companyId, branchId, code])
  @@index([companyId, branchId, scopeType, status, effectiveFrom, effectiveTo])
  @@index([companyId, branchId, productionUnitId])
  @@index([companyId, branchId, productionLineId])
  @@index([companyId, branchId, machineId])
  @@index([companyId, branchId, productionProductDefinitionId])
  @@index([supersedesId])
  @@map("production_performance_targets")
}

model ProductionPerformanceTargetTransition {
  id         String                      @id @default(cuid())
  companyId  String
  company    Company                     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId   String
  branch     Branch                      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetId   String
  target     ProductionPerformanceTarget @relation(fields: [targetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromStatus String
  toStatus   String
  action     String
  actorId    String
  reason     String?
  requestId  String
  createdAt  DateTime                    @default(now())

  @@unique([companyId, branchId, targetId, requestId])
  @@index([companyId, branchId, targetId, createdAt])
  @@index([companyId, branchId, action, createdAt])
  @@map("production_performance_target_transitions")
}

// ════ Batch A: Organization + People Foundation ═══════════════════════════════

model JobTitle {
