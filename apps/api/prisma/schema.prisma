  @@index([branchId])
  @@index([administrationId])
  @@index([departmentId])
  @@index([parentId])
  @@index([status])
  @@index([type, status])
  @@index([companyId, status])
  @@index([companyId, parentId, status])
  @@map("cost_centers")
}

// ── Operational Cost Center Assignment (Phase 2 Batch 2A) ─────
// Company-level (branchId-null) and branch-level assignments allowed.
// Resolution precedence is exclusive: specificity chain machine > line > unit,
// then effective-range containment at referenceDate, then priority (lower wins),
// then effectiveFrom, then createdAt. isPrimary is a display flag only.
model OperationalCostCenterAssignment {
  id               String          @id @default(cuid())
  code             String          @unique
  resourceType     String
  costCenterId     String
  costCenter       CostCenter      @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineId        String?
  machine          Machine?        @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId String?
  productionLine   ProductionLine? @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionUnitId String?
  productionUnit   ProductionUnit? @relation(fields: [productionUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  priority         Int             @default(0)
  source           String          @default("MANUAL")
  reason           String?
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           String          @default("DRAFT")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@index([code])
  @@index([resourceType])
  @@index([costCenterId])
  @@index([machineId])
  @@index([productionLineId])
  @@index([productionUnitId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([resourceType, machineId, effectiveFrom, effectiveTo])
  @@index([resourceType, productionLineId, effectiveFrom, effectiveTo])
  @@index([resourceType, productionUnitId, effectiveFrom, effectiveTo])
  @@map("operational_cost_center_assignments")
}

model SparePartConditionBalance {
