  @@map("inventory_valuation_balances")
}

// VAL-R1B: immutable legacy-stock monetary initialization evidence.
//
// One row per company + warehouse + product. It is the AUTHORITATIVE source of
// record proving each product's initial unit cost was captured. It is immutable
// after creation (no update/delete endpoint) and never alters physical inventory.
// quantitySnapshot is SYSTEM-DERIVED from the authoritative aggregated physical
// InventoryBalance.quantityBase (never client-supplied); totalValue is
// system-derived as quantitySnapshot x unitCost using Decimal arithmetic.
// The DB-level unique (companyId, warehouseId, productId) is the idempotency
// guard: a second initialization for the same company + warehouse + product is
// rejected rather than silently overwritten. Currency must exactly equal its
// InventoryValuationPolicy.currencyCode. Creation and the matching
// InventoryValuationBalance seed happen atomically in one transaction.
model InventoryValuationInitialization {
  id          String                   @id @default(cuid())
  companyId   String
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouseId String
  warehouse   Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId   String
  product     Product                  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policyId    String
  policy      InventoryValuationPolicy @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  quantitySnapshot Decimal @db.Decimal(18, 4)
  unitCost         Decimal @db.Decimal(19, 6)
  totalValue       Decimal @db.Decimal(19, 4)
  currencyCode     String
  reason           String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@unique([companyId, warehouseId, productId])
  @@index([warehouseId, productId])
  @@index([productId])
  @@index([policyId])
  @@map("inventory_valuation_initializations")
}

