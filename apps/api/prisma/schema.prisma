  @@index([resourceType])
  @@index([machineId])
  @@index([productionLineId])
  @@index([productionUnitId])
  @@index([shiftId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([companyId, branchId, status])
  @@index([resourceType, machineId, effectiveFrom, effectiveTo])
  @@index([resourceType, productionLineId, effectiveFrom, effectiveTo])
  @@index([resourceType, productionUnitId, effectiveFrom, effectiveTo])
  @@map("production_operational_assignments")
}

model User {
  id                String      @id @default(cuid())
