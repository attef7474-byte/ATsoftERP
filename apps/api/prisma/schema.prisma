  jobTitleId       String?
  jobTitle         JobTitle?         @relation(fields: [jobTitleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personnelId      String
  person           OperationalPerson @relation(fields: [personnelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignmentType   String            @default("PRIMARY")
  leadershipLevel  String            @default("NONE")
  effectiveFrom    DateTime
  effectiveTo      DateTime?
