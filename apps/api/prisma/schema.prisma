  @@index([companyId, branchId, documentType, status])
  @@index([companyId, branchId, productionOrderId])
  @@index([companyId, branchId, productionRunId, documentDate])
  @@index([companyId, branchId, requirementId])
  @@index([productionOrderId])
  @@index([productionRunId])
  @@index([movementId])
