  varianceQty         Float?
  // VAL-R1D: authoritative monetary source for a count surplus (variance > 0) on
  // an ACTIVE valuation warehouse. Written by the user (requires the valuation
  // cost-input permission), validated against the ACTIVE policy currency, and
  // used to apply the valued receipt for the surplus. Shortage (variance < 0)
  // revalues at the current moving average and leaves these null.
  unitCost            Decimal?               @db.Decimal(19, 6)
  currencyCode        String?
  valuationReason     String?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

