generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlserver"
}

// ── Business Partners ──────────────────────────────────────────

model BusinessPartnerGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.NVarChar(Max)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  partners BusinessPartner[]

  @@index([code])
  @@index([status])
  @@map("business_partner_groups")
}

model PaymentTerm {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?  @db.NVarChar(Max)
  days           Int      @default(0)
  discountDays   Int?
  discountPercent Decimal? @db.Decimal(9, 4)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  partners BusinessPartner[]

  @@index([code])
  @@index([status])
  @@map("payment_terms")
}

model BusinessPartner {
  id                      String   @id @default(cuid())
  code                    String   @unique
  type                    String   @default("CUSTOMER")
  status                  String   @default("ACTIVE")

  // Core identity
  name                    String
  legalName               String?
  commercialName          String?
  description             String?  @db.NVarChar(Max)

  // Classification
  groupId                 String?
  group                   BusinessPartnerGroup? @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentTermId           String?
  paymentTerm             PaymentTerm?           @relation(fields: [paymentTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Organization scope
  companyId               String?
  branchId                String?

  // Tax / Commercial
  taxNumber               String?
  commercialRegistrationNo String?
  vatRegistrationNo       String?
  nationalIdOrRegistryNo  String?

  // Contact summary
  phone                   String?
  mobile                  String?
  email                   String?
  website                 String?

  // Credit / Control
  creditLimit             Decimal? @db.Decimal(18, 4)
  creditUsed              Decimal? @db.Decimal(18, 4) @default(0)
  allowCredit             Boolean  @default(false)
  isBlocked               Boolean  @default(false)
  blockReason             String?
  blockNotes              String?  @db.NVarChar(Max)
  blockedAt               DateTime?
  blockedById             String?

  // Customer / Supplier flags
  isCustomer              Boolean  @default(false)
  isSupplier              Boolean  @default(false)

  // Notes
  notes                   String?  @db.NVarChar(Max)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deletedAt               DateTime?

  contacts    BusinessPartnerContact[]
  addresses   BusinessPartnerAddress[]
  bankAccounts BusinessPartnerBankAccount[]

  @@index([code])
  @@index([type])
  @@index([status])
  @@index([groupId])
  @@index([paymentTermId])
  @@index([companyId])
  @@index([branchId])
  @@index([taxNumber])
  @@index([commercialRegistrationNo])
  @@index([email])
  @@index([phone])
  @@index([isCustomer])
  @@index([isSupplier])
  @@index([isBlocked])
  @@map("business_partners")
}

model BusinessPartnerContact {
  id        String   @id @default(cuid())
  partnerId String
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type      String   @default("GENERAL")
  name      String
  jobTitle  String?
  phone     String?
  mobile    String?
  email     String?
  isPrimary Boolean  @default(false)
  notes     String?  @db.NVarChar(Max)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([partnerId])
  @@index([type])
  @@index([email])
  @@index([phone])
  @@index([isPrimary])
  @@map("business_partner_contacts")
}

model BusinessPartnerAddress {
  id           String   @id @default(cuid())
  partnerId    String
  partner      BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type         String   @default("BILLING")
  label        String?
  country      String?
  city         String?
  district     String?
  street       String?
  buildingNo   String?
  postalCode   String?
  addressLine1 String?  @db.NVarChar(500)
  addressLine2 String?  @db.NVarChar(500)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isPrimary    Boolean  @default(false)
  notes        String?  @db.NVarChar(Max)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([partnerId])
  @@index([type])
  @@index([city])
  @@index([isPrimary])
  @@map("business_partner_addresses")
}

model BusinessPartnerBankAccount {
  id            String   @id @default(cuid())
  partnerId     String
  partner       BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bankName      String
  accountName   String?
  accountNumber String?
  iban          String?
  swiftCode     String?
  currency      String?
  isPrimary     Boolean  @default(false)
  notes         String?  @db.NVarChar(Max)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([partnerId])
  @@index([iban])
  @@index([isPrimary])
  @@map("business_partner_bank_accounts")
}

// ── Existing Models ────────────────────────────────────────────

model Company {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  legalName String?
  taxNumber String?
  phone     String?
  email     String?
  address   String?
  logo      String?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches       Branch[]
  departments    Department[]
  users          User[]
  warehouses     Warehouse[]
  machines       Machine[]
  counts         InventoryCount[]
  movements      InventoryMovement[]
  adjustments    InventoryAdjustment[]
  costCenters      CostCenter[]
  productionLines  ProductionLine[]
  openingBalances  InventoryOpeningBalance[]
  stockAdjustments InventoryStockAdjustment[]
  stockTransfers   InventoryStockTransfer[]

  @@index([status])
  @@index([code])
  @@index([createdAt])
  @@map("companies")
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code      String
  name      String
  address   String?
  phone     String?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments    Department[]
  administrations Administration[]
  users          User[]
  warehouses     Warehouse[]
  machines       Machine[]
  numberSeqs     NumberSequence[]
  counts         InventoryCount[]
  movements      InventoryMovement[]
  adjustments    InventoryAdjustment[]
  costCenters      CostCenter[]
  productionLines  ProductionLine[]
  openingBalances  InventoryOpeningBalance[]
  stockAdjustments InventoryStockAdjustment[]
  stockTransfers   InventoryStockTransfer[]

  @@unique([companyId, code])
  @@index([status])
  @@index([createdAt])
  @@map("branches")
}

model Administration {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code      String
  name      String
  description String?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments      Department[]
  costCenters      CostCenter[]
  productionLines  ProductionLine[]
  technicalMachines Machine[] @relation("TechnicalAdministration")

  @@unique([branchId, code])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("administrations")
}

model Department {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  administrationId String?
  administration   Administration? @relation(fields: [administrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId         String?
  parent           Department?    @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children         Department[]   @relation("DepartmentHierarchy")
  code             String
  name             String
  status           String         @default("ACTIVE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  users            User[]
  machines         Machine[]
  technicalMachines Machine[] @relation("TechnicalDepartment")
  costCenters      CostCenter[]
  productionLines  ProductionLine[]

  @@unique([companyId, code])
  @@index([branchId])
  @@index([administrationId])
  @@index([status])
  @@index([createdAt])
  @@map("departments")
}

model ProductionLine {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  description      String?
  location         String?
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  administrationId String?
  administration   Administration? @relation(fields: [administrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  operationTypeId  String
  operationType    OperationType  @relation(fields: [operationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costCenterId     String?
  costCenter       CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           String         @default("ACTIVE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  machines            Machine[]
  maintenanceRequests MaintenanceRequest[]

  @@index([code])
  @@index([companyId])
  @@index([branchId])
  @@index([administrationId])
  @@index([departmentId])
  @@index([operationTypeId])
  @@index([costCenterId])
  @@index([status])
  @@index([companyId, status])
  @@map("production_lines")
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  name             String
  phone            String?
  avatar           String?
  status           String      @default("ACTIVE")
  companyId        String?
  company          Company?    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String?
  branch           Branch?     @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  twoFactorEnabled Boolean     @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  roles                    UserRole[]
  notifications            Notification[]
  attachments              Attachment[]
  auditLogs                AuditLog[]
  requestedMaintenanceReqs MaintenanceRequest[] @relation("MaintenanceRequestRequestedBy")
  assignedMaintenanceReqs  MaintenanceRequest[] @relation("MaintenanceRequestAssignedTo")
  requestedTasks           MaintenanceTask[]    @relation("MaintenanceTaskAssignedTo")
  checklistExecutionCompletions         MaintenanceChecklistExecution[]              @relation("MaintenanceChecklistExecutionCompletedBy")
  checklistExecutionItemCompletions     MaintenanceChecklistExecutionItem[]          @relation("MaintenanceChecklistExecutionItemCompletedBy")
  createdConversations                  InternalConversation[]                       @relation("UserCreatedConversations")
  conversationParticipants              InternalConversationParticipant[]
  sentMessages                         InternalMessage[]                            @relation("UserSentMessages")
  operationalPeople                    OperationalPerson[]
  rcaCompletedDowntimeLogs            DowntimeLog[]
  requestedRequiredParts              MaintenanceRequestRequiredPart[] @relation("RequiredPartRequestedBy")
  approvedRequiredParts               MaintenanceRequestRequiredPart[] @relation("RequiredPartApprovedBy")
  rejectedRequiredParts               MaintenanceRequestRequiredPart[] @relation("RequiredPartRejectedBy")
  reservedRequiredParts               MaintenanceRequestRequiredPart[] @relation("RequiredPartReservedBy")
  usedRequiredParts                   MaintenanceRequestRequiredPart[] @relation("RequiredPartUsedBy")
  cancelledRequiredParts              MaintenanceRequestRequiredPart[] @relation("RequiredPartCancelledBy")
  issuedStockRequiredParts             MaintenanceRequestRequiredPart[] @relation("PartStockIssuedBy")

  @@index([email])
  @@index([status])
  @@index([name])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([status, createdAt])
  @@map("users")
}

model Role {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       UserRole[]
  permissions RolePermission[]

  @@index([code])
  @@index([status])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
  @@index([action])
  @@index([module, action])
  @@index([status])
  @@map("permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, action])
  @@index([entity, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([read, createdAt])
  @@map("notifications")
}

model NotificationRule {
  id              String   @id @default(cuid())
  code            String   @unique
  nameAr          String
  nameEn          String
  description     String?
  eventType       String
  channel         String   @default("IN_APP")
  severity        String   @default("INFO")
  enabled         Boolean  @default(true)
  targetRoleId    String?
  targetPermission String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
  @@index([eventType])
  @@map("notification_rules")
}

model Attachment {
  id           String   @id @default(cuid())
  entityName   String
  entityId     String
  originalName String
  filePath     String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now())

  @@index([entityName])
  @@index([entityId])
  @@map("attachments")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  group       String
  label       String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}

model NumberSequence {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String
  operationName     String
  modelName         String
  domain            String
  prefix            String
  suffix            String?
  currentNumber     Int       @default(0)
  increment         Int       @default(1)
  padding           Int       @default(6)
  scope             String    @default("GLOBAL")
  companyId         String?
  branchId          String?
  branch            Branch?   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resetPolicy       String    @default("NEVER")
  lastResetAt       DateTime?
  lastGeneratedCode String?
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("number_sequences")
}

model Warehouse {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code      String
  name      String
  location  String?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  locations  WarehouseLocation[]
  balances   InventoryBalance[]
  counts     InventoryCount[]
  movements  InventoryMovement[]
  adjustments InventoryAdjustment[]
  stockIssuePartLines  MaintenanceRequestRequiredPart[]
  openingBalances      InventoryOpeningBalance[]
  stockAdjustments     InventoryStockAdjustment[]
  srcStockTransfers    InventoryStockTransfer[] @relation("srcWarehouse")
  dstStockTransfers    InventoryStockTransfer[] @relation("dstWarehouse")

  @@unique([companyId, code])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  barcode     String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  balances               InventoryBalance[]
  countLines             InventoryCountLine[]
  movementLines          InventoryMovementLine[]
  adjustmentLines        InventoryAdjustmentLine[]
  openingBalanceDocs     InventoryOpeningBalance[]
  openingBalanceLines    InventoryOpeningBalanceLine[]
  stockAdjustmentDocs    InventoryStockAdjustment[]
  stockAdjustmentLines   InventoryStockAdjustmentLine[]
  srcStockTransfers      InventoryStockTransfer[] @relation("srcLocation")
  dstStockTransfers      InventoryStockTransfer[] @relation("dstLocation")

  @@unique([warehouseId, code])
  @@index([status])
  @@index([barcode])
  @@map("warehouse_locations")
}

model ProductCategory {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?
  parentId    String?
  parent      ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ProductCategory[] @relation("ProductCategoryHierarchy")
  status      String            @default("ACTIVE")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@index([parentId])
  @@index([status])
  @@map("product_categories")
}

model Product {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit        String
  barcode     String?
  qrCode      String?
  image       String?
  minStock    Float            @default(0)
  maxStock    Float            @default(0)
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  balances            InventoryBalance[]
  parts               MachinePart[]
  countLines          InventoryCountLine[]
  movementLines       InventoryMovementLine[]
  adjustmentLines     InventoryAdjustmentLine[]
  requestPartUsages      MaintenanceRequestPartUsage[]
  spareParts             SparePart[]
  openingBalanceLines    InventoryOpeningBalanceLine[]
  stockAdjustmentLines   InventoryStockAdjustmentLine[]
  stockTransferLines     InventoryStockTransferLine[]

  @@index([categoryId])
  @@index([code])
  @@index([status])
  @@index([name])
  @@index([createdAt])
  @@index([categoryId, status])
  @@index([status, createdAt])
  @@map("products")
}

model InventoryBalance {
  id           String             @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locationId   String?
  location     WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId    String
  product      Product            @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity     Float              @default(0)
  batchNumber  String?
  serialNumber String?
  expiryDate   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([warehouseId, productId, batchNumber, serialNumber])
  @@index([warehouseId])
  @@index([productId])
  @@index([locationId])
  @@index([quantity])
  @@index([updatedAt])
  @@index([warehouseId, productId])
  @@map("inventory_balances")
}

model InventoryCount {
  id             String    @id @default(cuid())
  countNumber    String    @unique
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status         String    @default("DRAFT")
  countDate      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdById    String?
  startedById    String?
  completedById  String?
  cancelledById  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  lines         InventoryCountLine[]
  adjustments   InventoryAdjustment[]

  @@index([companyId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([status])
  @@index([countDate])
  @@index([countNumber])
  @@index([createdAt])
  @@index([warehouseId, status])
  @@index([status, createdAt])
  @@map("inventory_counts")
}

model InventoryCountLine {
  id                  String    @id @default(cuid())
  countId             String
  count               InventoryCount @relation(fields: [countId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId           String
  product             Product       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouseLocationId String?
  warehouseLocation   WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  systemQty           Float         @default(0)
  countedQty          Float?
  differenceQty       Float?
  status              String        @default("PENDING")
  countedAt           DateTime?
  verifiedAt          DateTime?
  countedById         String?
  verifiedById        String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  @@unique([countId, productId, warehouseLocationId])
  @@index([countId])
  @@index([productId])
  @@index([warehouseLocationId])
  @@index([status])
  @@index([countId, status])
  @@index([countId, productId])
  @@map("inventory_count_lines")
}

model InventoryMovement {
