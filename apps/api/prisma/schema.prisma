  productId             String
  product               Product                @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity              Float
  // VAL-R1D: the ONE authoritative monetary value for a valued transfer line.
  // Set only when both the source and destination warehouses are ACTIVE under a
  // WEIGHTED_AVERAGE policy with the same currency; it is used BOTH to decrement
  // the source valuation balance and to increment the destination balance, so
  // combined value is conserved. Null for legacy (unvalued) transfers.
  transferTotalValue    Decimal?               @db.Decimal(19, 4)
  notes                 String?
  transferOutMovementId String?
  transferInMovementId  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([transferId])
  @@index([productId])
  @@index([transferOutMovementId])
  @@index([transferInMovementId])
