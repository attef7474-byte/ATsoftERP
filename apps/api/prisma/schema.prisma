model MaintenanceRequest {
  id                 String    @id @default(cuid())
  requestNumber      String    @unique
  machineId          String
  machine            Machine   @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId   String?
  productionLine     ProductionLine? @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineComponentId String?
  machineComponent   MachineComponent? @relation(fields: [machineComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  operationTypeId    String?
  operationType      OperationType? @relation(fields: [operationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costCenterId       String?
  costCenter         CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type               String
  priority           String    @default("MEDIUM")
  title              String
  description        String?
  status             String    @default("OPEN")
  requestedById      String?
  requestedBy        User?     @relation("MaintenanceRequestRequestedBy", fields: [requestedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedToId       String?
  assignedTo         User?     @relation("MaintenanceRequestAssignedTo", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startDate          DateTime?
   endDate            DateTime?
   estimatedDurationMinutes Int?  @map("estimated_duration_minutes")
   downtimeHours      Float?
  cost               Float?
  isEmergency        Boolean?
  notes              String?
  // SLA fields (Batch M)
  responseDueAt      DateTime?
  startDueAt         DateTime?
  completeDueAt      DateTime?
  slaStatus          String?   @default("ON_TRACK")
  escalationLevel    String?   @default("NONE")
  lastEscalatedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tasks               MaintenanceTask[]
  schedules           MaintenanceSchedule[]
  downtimeLogs        DowntimeLog[]
  partUsages          MaintenanceRequestPartUsage[]
  costEntries         MaintenanceRequestCostEntry[]
  checklistExecutions MaintenanceChecklistExecution[]
  requiredParts       MaintenanceRequestRequiredPart[]
  assignments         MaintenanceRequestAssignment[]
  partAccountabilities MaintenancePartAccountability[]
  slaState            MaintenanceSlaState?

  @@index([machineId])
  @@index([productionLineId])
  @@index([machineComponentId])
  @@index([operationTypeId])
  @@index([costCenterId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([requestNumber])
  @@index([createdAt])
  @@index([status, priority])
  @@index([machineId, status])
  @@index([assignedToId, status])
  @@index([status, createdAt])
  @@map("maintenance_requests")
}

model MaintenanceRequestRequiredPart {
  id                   String   @id @default(cuid())
  maintenanceRequestId String
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sparePartId          String
  sparePart            SparePart @relation(fields: [sparePartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineComponentId   String?
  machineComponent     MachineComponent? @relation(fields: [machineComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineId            String?
  machine              Machine? @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity             Float
  unit                 String?
  usageNote            String?
  isPrimary            Boolean  @default(false)
  status               String   @default("REQUESTED")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  partAccountabilities MaintenancePartAccountability[]

  // Batch L — spare part request workflow fields (all nullable, backward compatible)
  reason               String?
  requestedQuantity    Float?
  approvedQuantity     Float?
  reservedQuantity     Float?
  usedQuantity         Float?
  requestedByUserId    String?
  requestedBy          User?    @relation("RequiredPartRequestedBy", fields: [requestedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedByUserId     String?
  approvedBy           User?    @relation("RequiredPartApprovedBy", fields: [approvedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rejectedByUserId     String?
  rejectedBy           User?    @relation("RequiredPartRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservedByUserId     String?
  reservedBy           User?    @relation("RequiredPartReservedBy", fields: [reservedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usedByUserId         String?
  usedBy               User?    @relation("RequiredPartUsedBy", fields: [usedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cancelledByUserId    String?
  cancelledBy          User?    @relation("RequiredPartCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  failureCauseId       String?
  failureCause         DowntimeLog? @relation(fields: [failureCauseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedAt          DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  reservedAt           DateTime?
  usedAt               DateTime?
  cancelledAt          DateTime?

  // Batch O — maintenance stock issue fields (backward compatible, all nullable)
  issuedQuantity       Float?    @default(0)
  returnedQuantity     Float?    @default(0)
  stockIssueStatus     String?   @default("NOT_ISSUED")
  warehouseId          String?
  warehouse            Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastIssueAt          DateTime?
  lastIssueByUserId    String?
  lastIssueBy          User?     @relation("PartStockIssuedBy", fields: [lastIssueByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([maintenanceRequestId, sparePartId])
  @@index([maintenanceRequestId])
  @@index([sparePartId])
  @@index([machineComponentId])
  @@index([machineId])
  @@index([status])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([reservedByUserId])
  @@index([usedByUserId])
  @@index([failureCauseId])
  @@map("maintenance_request_required_parts")
}

model MaintenanceSlaRule {
  id        String   @id @default(cuid())
  name      String
  priority  String?  @default("MEDIUM")
  type      String?  @default("BOTH")
  responseHours Float?
  startHours    Float?
  completeHours Float?
  escalationDelayHours Float? @default(0)
  escalationLevels      Int?    @default(1)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([priority])
  @@index([type])
  @@index([isActive])
  @@map("maintenance_sla_rules")
}

model MaintenanceSlaState {
  id                  String   @id @default(cuid())
  maintenanceRequestId String
  maintenanceRequest  MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  responseDueAt      DateTime?
  startDueAt         DateTime?
  completeDueAt      DateTime?
  slaStatus          String   @default("ON_TRACK")
  escalationLevel    String   @default("NONE")
  lastEscalatedAt    DateTime?
  responseActualAt   DateTime?
  startActualAt      DateTime?
  completeActualAt   DateTime?
  responseOverdueMin Int?
  startOverdueMin    Int?
  completeOverdueMin Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([maintenanceRequestId])
  @@index([slaStatus])
  @@index([escalationLevel])
  @@map("maintenance_sla_states")
}

model OperationalPerson {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String   @default("MAINTENANCE")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  isActive  Boolean  @default(true)
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenancePersonnel MaintenancePersonnel?

  @@index([code])
  @@index([category])
  @@index([userId])
  @@index([isActive])
  @@map("operational_people")
}

model MaintenancePersonnel {
  id                   String             @id @default(cuid())
  operationalPersonId  String             @unique
  operationalPerson    OperationalPerson  @relation(fields: [operationalPersonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role                 String
  specialty            String?
   isActive             Boolean            @default(true)
   dailyCapacityMinutes Int                @default(480) @map("daily_capacity_minutes")
   createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  machineResponsibilities  MachineResponsibilityAssignment[]
  requestAssignments       MaintenanceRequestAssignment[]
  partAccountabilities     MaintenancePartAccountability[]

  @@index([role])
  @@index([specialty])
  @@index([isActive])
  @@map("maintenance_personnel")
}

model MachineResponsibilityAssignment {
  id                     String   @id @default(cuid())
  machineId              String
  machine                Machine  @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenancePersonnelId String
  maintenancePersonnel   MaintenancePersonnel @relation(fields: [maintenancePersonnelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsibilityRole     String
  isPrimary              Boolean  @default(false)
  startDate              DateTime
  endDate                DateTime?
  status                 String   @default("ACTIVE")
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([machineId])
  @@index([maintenancePersonnelId])
  @@index([responsibilityRole])
  @@index([isPrimary])
  @@index([status])
  @@index([machineId, maintenancePersonnelId, status])
  @@map("machine_responsibility_assignments")
}

model MaintenanceRequestAssignment {
  id                     String   @id @default(cuid())
  maintenanceRequestId   String
  maintenanceRequest     MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenancePersonnelId String
  maintenancePersonnel   MaintenancePersonnel @relation(fields: [maintenancePersonnelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignmentRole         String
  status                 String   @default("ASSIGNED")
  assignedAt             DateTime @default(now())
  acceptedAt             DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([maintenanceRequestId])
  @@index([maintenancePersonnelId])
  @@index([assignmentRole])
  @@index([status])
  @@index([maintenanceRequestId, maintenancePersonnelId, status])
  @@map("maintenance_request_assignments")
}

model MaintenancePartAccountability {
  id                     String   @id @default(cuid())
  maintenanceRequestId   String
  maintenanceRequest     MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requiredPartId         String
  requiredPart           MaintenanceRequestRequiredPart @relation(fields: [requiredPartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sparePartId            String
  sparePart              SparePart @relation(fields: [sparePartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineId              String?
  machine                Machine?  @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineComponentId     String?
  machineComponent       MachineComponent? @relation(fields: [machineComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenancePersonnelId String
  maintenancePersonnel   MaintenancePersonnel @relation(fields: [maintenancePersonnelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity               Float
  reportedUsedQuantity   Float?
  returnedQuantity       Float?
  status                 String   @default("ASSIGNED")
  accountabilityNote     String?
  assignedAt             DateTime @default(now())
  reportedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([maintenanceRequestId])
  @@index([requiredPartId])
  @@index([sparePartId])
  @@index([machineId])
  @@index([machineComponentId])
  @@index([maintenancePersonnelId])
  @@index([status])
  @@map("maintenance_part_accountability")
}

model MaintenanceTask {
  id           String             @id @default(cuid())
  requestId    String
  request      MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title        String
  description  String?
  status       String             @default("PENDING")
  assignedToId String?
  assignedTo   User?              @relation("MaintenanceTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([requestId])
  @@index([assignedToId])
  @@index([status])
  @@index([requestId, status])
  @@index([assignedToId, status])
  @@index([completedAt])
  @@map("maintenance_tasks")
}

model MaintenanceSchedule {
  id           String              @id @default(cuid())
  machineId    String
  machine      Machine             @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId    String?
  request      MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type         String
  frequency    String
  intervalDays Int?
  startDate    DateTime
  endDate      DateTime?
  title        String
  description  String?
  status       String              @default("ACTIVE")
  nextDueDate  DateTime?
  lastGeneratedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  checklistItems    MaintenanceChecklistItem[]
  checklistExecutions MaintenanceChecklistExecution[]

  @@index([machineId])
  @@index([status])
  @@index([type])
  @@index([machineId, status])
  @@index([startDate])
  @@index([endDate])
  @@map("maintenance_schedules")
}

model MaintenanceChecklistItem {
  id          String              @id @default(cuid())
  scheduleId  String
  schedule    MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  description String?
  sortOrder   Int                 @default(0)
  isMandatory Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  executionItems  MaintenanceChecklistExecutionItem[]

  @@index([scheduleId])
  @@map("maintenance_checklist_items")
}

model DowntimeLog {
  id                  String              @id @default(cuid())
  machineId           String
  machine             Machine             @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId           String?
  request             MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startTime           DateTime
  endTime             DateTime?
  durationMinutes     Float?
  reason              String
  failureCause        String?
  failureCategory     String?
  rootCause           String?
  correctiveAction    String?
  preventiveAction    String?
  detectedAt          DateTime?
  responseStartedAt   DateTime?
  repairStartedAt     DateTime?
  repairCompletedAt   DateTime?
  isRepeatFailure     Boolean?
  repeatedFailureGroupId String?
  machineStopped      Boolean?
  productionImpact    String?
  rcaStatus           String?             @default("PENDING")
  rcaCompletedByUserId String?
  rcaCompletedBy      User?               @relation(fields: [rcaCompletedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rcaCompletedAt      DateTime?
  notes               String?
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  requiredParts       MaintenanceRequestRequiredPart[]

  @@index([machineId])
  @@index([requestId])
  @@index([startTime])
  @@index([machineId, startTime])
  @@index([requestId, cancelledAt])
  @@index([endTime, cancelledAt])
  @@index([failureCategory])
  @@index([rcaStatus])
  @@map("downtime_logs")
}

// ── Maintenance Request Part Usage ──────────────────────────────
model MaintenanceRequestPartUsage {
  id        String   @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Float
  unitCost  Float?
  totalCost Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([productId])
  @@map("maintenance_request_part_usages")
}

// ── Maintenance Request Cost Entry ──────────────────────────────
model MaintenanceRequestCostEntry {
  id          String   @id @default(cuid())
  requestId   String
  request     MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type        String
  description String?
  amount      Float
  incurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requestId])
  @@map("maintenance_request_cost_entries")
}

// ── Maintenance Checklist Execution ─────────────────────────────
model MaintenanceChecklistExecution {
  id          String   @id @default(cuid())
  scheduleId  String
  schedule    MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId   String?
  request     MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String   @default("IN_PROGRESS")
  startedAt   DateTime @default(now())
  completedAt DateTime?
  completedById String?
  completedBy   User?    @relation("MaintenanceChecklistExecutionCompletedBy", fields: [completedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items MaintenanceChecklistExecutionItem[]

  @@index([scheduleId])
  @@index([requestId])
  @@index([status])
  @@index([scheduleId, status])
  @@index([requestId, status])
  @@map("maintenance_checklist_executions")
}

// ── Maintenance Checklist Execution Item ────────────────────────
model MaintenanceChecklistExecutionItem {
  id            String   @id @default(cuid())
  executionId   String
  execution     MaintenanceChecklistExecution @relation(fields: [executionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checklistItemId String
  checklistItem MaintenanceChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status        String   @default("PENDING")
  passed        Boolean?
  notes         String?
  completedAt   DateTime?
  completedById String?
  completedBy   User?    @relation("MaintenanceChecklistExecutionItemCompletedBy", fields: [completedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([executionId])
  @@index([checklistItemId])
  @@map("maintenance_checklist_execution_items")
}

// ── Barcode / QR ────────────────────────────────────────────────

model BarcodeLabel {
  id                 String   @id @default(cuid())
  code               String   @unique
  value              String   @unique
  symbology          String   @default("QR_CODE")
  entityType         String
  entityId           String
  status             String   @default("ACTIVE")
  title              String?
  description        String?  @db.NVarChar(Max)
  qrPayload          String?  @db.NVarChar(Max)
  humanReadableValue String?
  labelTemplateCode  String?
  printCount         Int      @default(0)
  lastPrintedAt      DateTime?
  lastScannedAt      DateTime?
  scanCount          Int      @default(0)
  createdById        String?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  scanEvents BarcodeScanEvent[]
  printJobs  BarcodePrintJob[]

  @@index([code])
  @@index([value])
  @@index([entityType])
  @@index([entityId])
  @@index([status])
  @@index([symbology])
  @@index([entityType, entityId])
  @@index([status, entityType])
  @@index([entityType, entityId, status])
  @@index([status, createdAt])
  @@map("barcode_labels")
}

model BarcodeScanEvent {
  id           String   @id @default(cuid())
  labelId      String?
  label        BarcodeLabel? @relation(fields: [labelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scannedValue String
  symbology    String?
  purpose      String   @default("GENERAL_LOOKUP")
  result       String   @default("SUCCESS")
  source       String   @default("WEB")
  entityType   String?
  entityId     String?
  contextType  String?
  contextId    String?
  message      String?  @db.NVarChar(500)
  metadata     String?  @db.NVarChar(Max)
  scannedById  String?
  scannedAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([scannedValue])
  @@index([labelId])
  @@index([result])
  @@index([purpose])
  @@index([entityType])
  @@index([entityId])
  @@index([contextType, contextId])
  @@index([scannedById])
  @@index([scannedAt])
  @@index([labelId, result])
  @@index([scannedById, scannedAt])
  @@map("barcode_scan_events")
}

model BarcodeLabelTemplate {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?  @db.NVarChar(Max)
  symbology    String   @default("QR_CODE")
  entityType   String?
  widthMm      Decimal? @db.Decimal(9, 2)
  heightMm     Decimal? @db.Decimal(9, 2)
  templateData String?  @db.NVarChar(Max)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([code])
  @@index([symbology])
  @@index([entityType])
  @@index([status])
  @@index([status, entityType])
  @@map("barcode_label_templates")
}

model BarcodePrintJob {
  id            String   @id @default(cuid())
  labelId       String?
  label         BarcodeLabel? @relation(fields: [labelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templateId    String?
  entityType    String?
  entityId      String?
  printerName   String?
  copies        Int      @default(1)
  status        String   @default("PENDING")
  printedById   String?
  jobType       String   @default("LABEL")
  note          String?  @db.NVarChar(500)
  metadata      String?  @db.NVarChar(Max)
  requestedAt   DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([labelId])
  @@index([templateId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([printedById])
  @@index([requestedAt])
  @@map("barcode_print_jobs")
}

// ── Internal Messaging ──────────────────────────────────────────

model InternalConversation {
  id              String                           @id @default(cuid())
  title           String?                          @db.NVarChar(200)
  createdByUserId String
  createdBy       User                             @relation("UserCreatedConversations", fields: [createdByUserId], references: [id])
  lastMessageAt   DateTime?
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  deletedAt       DateTime?
  participants    InternalConversationParticipant[]
  messages        InternalMessage[]

  @@index([createdByUserId])
  @@index([lastMessageAt])
  @@map("internal_conversations")
}

model InternalConversationParticipant {
  id             String             @id @default(cuid())
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  joinedAt       DateTime           @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("internal_conversation_participants")
}

model InternalMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User                 @relation("UserSentMessages", fields: [senderUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  body           String               @db.NVarChar(Max)
  createdAt      DateTime             @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  isSystem       Boolean              @default(false)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("internal_messages")
}

// ── Operation Type ────────────────────────────────────────────
model OperationType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  productionLines     ProductionLine[]
  machines            Machine[]
  maintenanceRequests MaintenanceRequest[]

  @@index([code])
  @@index([status])
  @@index([status, createdAt])
  @@map("operation_types")
}

// ── Cost Center ───────────────────────────────────────────────
model CostCenter {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  description      String?
  type             String
  companyId        String?
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  administrationId String?
  administration   Administration? @relation(fields: [administrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           String         @default("ACTIVE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  @@index([code])
  @@index([type])
  @@index([companyId])
  @@index([branchId])
  @@index([administrationId])
  @@index([departmentId])
  @@index([status])
  productionLines     ProductionLine[]
  machines            Machine[]
  maintenanceRequests MaintenanceRequest[]

  @@index([type, status])
  @@index([companyId, status])
  @@map("cost_centers")
}
