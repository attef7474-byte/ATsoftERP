  @@index([labelId])
  @@index([result])
  @@index([purpose])
  @@index([entityType])
  @@index([entityId])
  @@index([contextType, contextId])
  @@index([scannedById])
  @@index([scannedAt])
  @@index([labelId, result])
  @@index([scannedById, scannedAt])
