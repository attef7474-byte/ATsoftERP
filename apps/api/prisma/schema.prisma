// ── Repairable Spare Parts / Repair Orders ─────────────────────

/// Repairable spare part repair order/workflow
/// Tracks inspection, repair, overhaul, test, and scrap lifecycle
model SparePartRepairOrder {
  id                         String                          @id @default(cuid())
  repairOrderNumber          String?                         @unique @map("repair_order_number")
  sparePartId                String                          @map("spare_part_id")
  sparePart                  SparePart                       @relation(fields: [sparePartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId                  String?                         @map("product_id")
  warehouseId                String                          @map("warehouse_id")
  warehouse                  Warehouse                       @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceCondition            String                          @map("source_condition")
  sourceQuantity             Float                           @map("source_quantity")
  reservedQuantity           Float                           @default(0) @map("reserved_quantity")
  repairedQuantity           Float                           @default(0) @map("repaired_quantity")
  scrappedQuantity           Float                           @default(0) @map("scrapped_quantity")
  remainingQuantity          Float                           @default(0) @map("remaining_quantity")
  targetCondition            String?                         @map("target_condition")
  status                     String                          @default("DRAFT")
  sourceType                 String?                         @map("source_type")
  sourceId                   String?                         @map("source_id")
  maintenanceRequestId       String?                         @map("maintenance_request_id")
  maintenanceRequest         MaintenanceRequest?             @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requiredPartId             String?                         @map("required_part_id")
  requiredPart               MaintenanceRequestRequiredPart? @relation(fields: [requiredPartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacementHistoryId       String?                         @map("replacement_history_id")
  installedPartId            String?                         @map("installed_part_id")
  conditionInMovementId      String?                         @map("condition_in_movement_id")
  conditionOutMovementId     String?                         @map("condition_out_movement_id")
  inventoryScrapMovementId   String?                         @map("inventory_scrap_movement_id")
  machineId                  String?                         @map("machine_id")
  machine                    Machine?                        @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineComponentId         String?                         @map("machine_component_id")
  machineComponent           MachineComponent?               @relation(fields: [machineComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inspectionResult           String?                         @map("inspection_result") @db.NVarChar(500)
  failureDescription         String?                         @map("failure_description") @db.NVarChar(1000)
  repairDescription          String?                         @map("repair_description") @db.NVarChar(1000)
  testResult                 String?                         @map("test_result") @db.NVarChar(500)
  testNotes                  String?                         @map("test_notes") @db.NVarChar(500)
  externalRepair             Boolean                         @default(false) @map("external_repair")
  externalRepairProviderName String?                         @map("external_repair_provider_name") @db.NVarChar(200)
  estimatedRepairCost        Decimal?                        @map("estimated_repair_cost") @db.Decimal(18, 2)
  actualRepairCost           Decimal?                        @map("actual_repair_cost") @db.Decimal(18, 2)
  openedByUserId             String?                         @map("opened_by_user_id")
  inspectedByUserId          String?                         @map("inspected_by_user_id")
  repairedByUserId           String?                         @map("repaired_by_user_id")
  testedByUserId             String?                         @map("tested_by_user_id")
  closedByUserId             String?                         @map("closed_by_user_id")
  openedAt                   DateTime                        @default(now()) @map("opened_at")
  inspectionStartedAt        DateTime?                       @map("inspection_started_at")
  repairStartedAt            DateTime?                       @map("repair_started_at")
  testStartedAt              DateTime?                       @map("test_started_at")
  completedAt                DateTime?                       @map("completed_at")
  cancelledAt                DateTime?                       @map("cancelled_at")
  cancelReason               String?                         @map("cancel_reason") @db.NVarChar(500)
  notes                      String?                         @db.NVarChar(1000)
  createdAt                  DateTime                        @default(now()) @map("created_at")
  updatedAt                  DateTime                        @updatedAt @map("updated_at")

  actions SparePartRepairAction[]

  @@index([repairOrderNumber])
  @@index([sparePartId])
  @@index([productId])
  @@index([warehouseId])
  @@index([status])
  @@index([sourceCondition])
  @@index([targetCondition])
  @@index([maintenanceRequestId])
  @@index([requiredPartId])
  @@index([replacementHistoryId])
  @@index([conditionInMovementId])
  @@index([machineId])
  @@index([machineComponentId])
  @@index([openedAt])
  @@index([completedAt])
  @@index([sourceType, sourceId])
  @@map("spare_part_repair_orders")
}

/// Repair actions / overhaul steps within a repair order
model SparePartRepairAction {
  id                String               @id @default(cuid())
  repairOrderId     String               @map("repair_order_id")
  repairOrder       SparePartRepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  actionType        String               @map("action_type")
  actionStatus      String               @default("PLANNED") @map("action_status")
  description       String?              @db.NVarChar(1000)
  result            String?              @db.NVarChar(500)
  performedByUserId String?              @map("performed_by_user_id")
  performedAt       DateTime?            @map("performed_at")
  durationMinutes   Int?                 @map("duration_minutes")
  notes             String?              @db.NVarChar(500)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([repairOrderId])
  @@index([actionType])
  @@index([actionStatus])
  @@index([performedAt])
  @@map("spare_part_repair_actions")
}

// ── Installed Parts ─────────────────────────────────────────────
model MachineInstalledPart {
  id                      String                          @id @default(cuid())
  machineId               String                          @map("machine_id")
  machine                 Machine                         @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineComponentId      String?                         @map("machine_component_id")
  machineComponent        MachineComponent?               @relation(fields: [machineComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sparePartId             String                          @map("spare_part_id")
  sparePart               SparePart                       @relation(fields: [sparePartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId               String?                         @map("product_id")
  maintenanceRequestId    String?                         @map("maintenance_request_id")
  maintenanceRequest      MaintenanceRequest?             @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requiredPartId          String?                         @map("required_part_id")
  requiredPart            MaintenanceRequestRequiredPart? @relation(fields: [requiredPartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventoryMovementId     String?                         @map("inventory_movement_id")
  inventoryMovement       InventoryMovement?              @relation(fields: [inventoryMovementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conditionMovementId     String?                         @map("condition_movement_id")
  installedQuantity       Float                           @map("installed_quantity")
  installedCondition      String                          @default("NEW") @map("installed_condition")
  installedAt             DateTime                        @default(now()) @map("installed_at")
  installedByUserId       String?                         @map("installed_by_user_id")
  sourceType              String?                         @map("source_type")
  sourceId                String?                         @map("source_id")
  serialNumber            String?                         @map("serial_number")
  batchNumber             String?                         @map("batch_number")
  status                  String                          @default("ACTIVE")
  removedAt               DateTime?                       @map("removed_at")
  removedByUserId         String?                         @map("removed_by_user_id")
  removedCondition        String?                         @map("removed_condition")
  removedQuantity         Float?                          @map("removed_quantity")
  removedReason           String?                         @map("removed_reason")
  notes                   String?
  // UX-1B-2C: expected-life tracking (additive)
  expectedLifeValue       Float?                          @map("expected_life_value")
  expectedLifeUnit        String?                         @map("expected_life_unit") // DAYS | HOURS | CYCLES
  lifeStartDate           DateTime?                       @map("life_start_date")
  lifeStartReading        Float?                          @map("life_start_reading")
  currentReading          Float?                          @map("current_reading")
  warningThresholdPercent Int?                            @default(80) @map("warning_threshold_percent")
  expectedExpiryDate      DateTime?                       @map("expected_expiry_date")
  expectedExpiryReading   Float?                          @map("expected_expiry_reading")
  lifeStatus              String?                         @default("UNKNOWN") @map("life_status") // UNKNOWN | NORMAL | WARNING | DUE | EXPIRED
  lastEvaluatedAt         DateTime?                       @map("last_evaluated_at")
  alertThresholdReached   String?                         @default("NONE") @map("alert_threshold_reached") // NONE | WARNING | DUE | EXPIRED (idempotency marker)
  expectedLifeAlertAt     DateTime?                       @map("expected_life_alert_at")
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")

  replacementHistoryNew SparePartReplacementHistory[] @relation("NewInstalledPart")
  replacementHistoryOld SparePartReplacementHistory[] @relation("OldInstalledPart")
  readings              MachineInstalledPartReading[]

  @@index([machineId])
  @@index([machineComponentId])
  @@index([sparePartId])
  @@index([maintenanceRequestId])
  @@index([requiredPartId])
  @@index([status])
  @@index([installedAt])
  @@index([lifeStatus])
  @@map("machine_installed_parts")
}

// ── Installed Part Readings (UX-1B-2C) ─────────────────────────
model MachineInstalledPartReading {
  id               String               @id @default(cuid())
  installedPartId  String
  installedPart    MachineInstalledPart @relation(fields: [installedPartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  readingType      String // HOURS | CYCLES
  readingValue     Float
  isReset          Boolean              @default(false)
  recordedByUserId String?
  recordedBy       User?                @relation(fields: [recordedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedAt       DateTime             @default(now())
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([installedPartId])
  @@index([recordedAt])
  @@map("machine_installed_part_readings")
}

// ── Replacement History ─────────────────────────────────────────
model SparePartReplacementHistory {
