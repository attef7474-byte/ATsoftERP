  counts                           InventoryCount[]
  movements                        InventoryMovement[]
  adjustments                      InventoryAdjustment[]
  costCenters                      CostCenter[]
  productionLines                  ProductionLine[]
  openingBalances                  InventoryOpeningBalance[]
  stockAdjustments                 InventoryStockAdjustment[]
  stockTransfers                   InventoryStockTransfer[]
  operationalReceipts              InventoryOperationalReceipt[]
  physicalCounts                   InventoryPhysicalCount[]
  operationalScopes                UserOperationalScope[]
  productionUnits                  ProductionUnit[]
  productionProducts               ProductionProductDefinition[]
  productionShifts                 ProductionShift[]
  productionShiftTemplates         ProductionShiftTemplate[]
  productionShiftCalendars         ProductionShiftCalendar[]
  productionShiftAssignments       ProductionShiftAssignment[]
  productionOperationalAssignments ProductionOperationalAssignment[]
  productionCapacityStandards      ProductionCapacityStandard[]
  productionOrders                 ProductionOrder[]
  productionOrderTransitions       ProductionOrderTransition[]
  productionOrderAttachments       ProductionOrderAttachment[]
  productionRuns                   ProductionRun[]
  productionRunSessions            ProductionRunSession[]
  productionRunTransitions         ProductionRunTransition[]
  productionMeasurementPoints      ProductionMeasurementPoint[]
  productionOutputEvents           ProductionOutputEvent[]
  operationalLossReasons           OperationalLossReason[]
  downtimeSegments                 DowntimeSegment[]
  productionLossQuantityEvents     ProductionLossQuantityEvent[]
  materialDocuments                ProductionMaterialDocument[]
  finishedGoodsReceipts            ProductionFinishedGoodsReceipt[]
  materialRequirements             ProductionMaterialRequirement[]
  materialConsumptions             ProductionMaterialConsumption[]
  materialDocumentLines            ProductionMaterialDocumentLine[]
  fgReceiptLines                   ProductionFinishedGoodsReceiptLine[]
  requirementLines                 ProductionMaterialRequirementLine[]
  consumptionCorrections           ProductionMaterialConsumptionCorrection[]
  qualityPlans                     ProductionQualityPlan[]
  qualityCharacteristics           QualityCharacteristic[]
  qualitySamplingPoints            QualitySamplingPoint[]
  inspections                      ProductionInspection[]
  inspectionResults                ProductionInspectionResult[]
  qualityDispositions              ProductionQualityDisposition[]
  nonconformances                  ProductionNonconformance[]
  nonconformanceTransitions        ProductionNonconformanceTransition[]
  nonconformanceAttachments        ProductionNonconformanceAttachment[]
  costRates                        OperationalCostRate[]
  standardCostSnapshots            OperationalStandardCostSnapshot[]
  costTransactions                 OperationalCostTransaction[]
  performanceTargets               ProductionPerformanceTarget[]
  performanceTargetTransitions     ProductionPerformanceTargetTransition[]
  costCalculations                 OperationalCostCalculation[]
  sourceChanges                    OperationalSourceChange[]
  operationalCostCenterAssignments OperationalCostCenterAssignment[]
  inventoryLocks                   InventoryLock[]
  jobTitles                        JobTitle[]
  personAssignments                OperationalPersonAssignment[]
  supervisorAssignments            SupervisorAssignment[]
  shiftHandovers                   ShiftHandover[]
  shiftHandoverItems               ShiftHandoverItem[]
  valuationPolicies                InventoryValuationPolicy[]
  valuationBalances                InventoryValuationBalance[]
  valuationInitializations         InventoryValuationInitialization[]
  productionRunCostSnapshots       ProductionRunCostSnapshot[]

  @@index([status])
  @@index([code])
  @@index([createdAt])
  @@map("companies")
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code      String
  name      String
  address   String?
  phone     String?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments                      Department[]
  administrations                  Administration[]
  organizationalUnits              OrganizationalUnit[]
  maintenanceWorkOrders            MaintenanceWorkOrder[]
  users                            User[]
  warehouses                       Warehouse[]
  machines                         Machine[]
  numberSeqs                       NumberSequence[]
  counts                           InventoryCount[]
  movements                        InventoryMovement[]
  adjustments                      InventoryAdjustment[]
  costCenters                      CostCenter[]
  productionLines                  ProductionLine[]
  openingBalances                  InventoryOpeningBalance[]
  stockAdjustments                 InventoryStockAdjustment[]
  stockTransfers                   InventoryStockTransfer[]
  operationalReceipts              InventoryOperationalReceipt[]
  physicalCounts                   InventoryPhysicalCount[]
  operationalScopes                UserOperationalScope[]
  productionUnits                  ProductionUnit[]
  productionProducts               ProductionProductDefinition[]
  productionShifts                 ProductionShift[]
  productionShiftTemplates         ProductionShiftTemplate[]
  productionShiftCalendars         ProductionShiftCalendar[]
  productionShiftAssignments       ProductionShiftAssignment[]
  productionOperationalAssignments ProductionOperationalAssignment[]
  productionCapacityStandards      ProductionCapacityStandard[]
  productionOrders                 ProductionOrder[]
  productionOrderTransitions       ProductionOrderTransition[]
  productionOrderAttachments       ProductionOrderAttachment[]
  productionRuns                   ProductionRun[]
  productionRunSessions            ProductionRunSession[]
  productionRunTransitions         ProductionRunTransition[]
  productionMeasurementPoints      ProductionMeasurementPoint[]
  productionOutputEvents           ProductionOutputEvent[]
  operationalLossReasons           OperationalLossReason[]
  downtimeSegments                 DowntimeSegment[]
  productionLossQuantityEvents     ProductionLossQuantityEvent[]
  materialDocuments                ProductionMaterialDocument[]
  finishedGoodsReceipts            ProductionFinishedGoodsReceipt[]
  materialRequirements             ProductionMaterialRequirement[]
  materialConsumptions             ProductionMaterialConsumption[]
  materialDocumentLines            ProductionMaterialDocumentLine[]
  fgReceiptLines                   ProductionFinishedGoodsReceiptLine[]
  requirementLines                 ProductionMaterialRequirementLine[]
  consumptionCorrections           ProductionMaterialConsumptionCorrection[]
  qualityPlans                     ProductionQualityPlan[]
  qualityCharacteristics           QualityCharacteristic[]
  qualitySamplingPoints            QualitySamplingPoint[]
  inspections                      ProductionInspection[]
  inspectionResults                ProductionInspectionResult[]
  qualityDispositions              ProductionQualityDisposition[]
  nonconformances                  ProductionNonconformance[]
  nonconformanceTransitions        ProductionNonconformanceTransition[]
  nonconformanceAttachments        ProductionNonconformanceAttachment[]
  costRates                        OperationalCostRate[]
  standardCostSnapshots            OperationalStandardCostSnapshot[]
  costTransactions                 OperationalCostTransaction[]
  performanceTargets               ProductionPerformanceTarget[]
  performanceTargetTransitions     ProductionPerformanceTargetTransition[]
  costCalculations                 OperationalCostCalculation[]
  sourceChanges                    OperationalSourceChange[]
  operationalCostCenterAssignments OperationalCostCenterAssignment[]
  inventoryLocks                   InventoryLock[]
  personAssignments                OperationalPersonAssignment[]
  shiftHandovers                   ShiftHandover[]
  productionRunCostSnapshots       ProductionRunCostSnapshot[]

  @@unique([companyId, code])
  @@index([status])
  @@index([createdAt])
  @@map("branches")
}

model Administration {
  id          String    @id @default(cuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  departments       Department[]
  costCenters       CostCenter[]
  productionLines   ProductionLine[]
  technicalMachines Machine[]                     @relation("TechnicalAdministration")
  operationalScopes UserOperationalScope[]
  personAssignments OperationalPersonAssignment[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("administrations")
}

model Department {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  administrationId String?
  administration   Administration? @relation(fields: [administrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId         String?
  parent           Department?     @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children         Department[]    @relation("DepartmentHierarchy")
  code             String
  name             String
  classification   String          @default("OPERATIONAL")
  status           String          @default("ACTIVE")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  users                   User[]
  machines                Machine[]
  technicalMachines       Machine[]                         @relation("TechnicalDepartment")
  costCenters             CostCenter[]
  productionLines         ProductionLine[]
  operationalScopes       UserOperationalScope[]
  personAssignments       OperationalPersonAssignment[]
  machineResponsibilities MachineResponsibilityAssignment[]
  shiftHandovers          ShiftHandover[]

  @@unique([companyId, code])
  @@index([branchId])
  @@index([administrationId])
  @@index([status])
  @@index([createdAt])
  @@map("departments")
}

model OrganizationalUnit {
  id        String               @id @default(cuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId  String
  branch    Branch               @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId  String?
  parent    OrganizationalUnit?  @relation("OrganizationalUnitHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  OrganizationalUnit[] @relation("OrganizationalUnitHierarchy")
  code      String
  name      String
  type      String               @default("DEPARTMENT")
  status    String               @default("ACTIVE")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  deletedAt DateTime?

  @@unique([branchId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([parentId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, status])
  @@map("organizational_units")
}

model ProductionLine {
  id               String          @id @default(cuid())
  code             String          @unique
  name             String
  description      String?
  location         String?
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  administrationId String?
  administration   Administration? @relation(fields: [administrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId     String
  department       Department      @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  operationTypeId  String
  operationType    OperationType   @relation(fields: [operationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costCenterId     String?
  costCenter       CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           String          @default("ACTIVE")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  machines                         Machine[]
  maintenanceRequests              MaintenanceRequest[]
  productionProducts               ProductionProductDefinition[]
  productionEligibilities          ProductionEligibility[]
  operationalAssignments           ProductionOperationalAssignment[]
  operationalCostCenterAssignments OperationalCostCenterAssignment[]
  capacityStandards                ProductionCapacityStandard[]
  productionOrders                 ProductionOrder[]
  productionMeasurementPoints      ProductionMeasurementPoint[]
  downtimeLogs                     DowntimeLog[]
  downtimeSegments                 DowntimeSegment[]
  lossQuantityEvents               ProductionLossQuantityEvent[]
  qualityPlans                     ProductionQualityPlan[]
  qualitySamplingPoints            QualitySamplingPoint[]
  inspections                      ProductionInspection[]
  costRates                        OperationalCostRate[]
  standardCostSnapshots            OperationalStandardCostSnapshot[]
  costTransactions                 OperationalCostTransaction[]
  performanceTargets               ProductionPerformanceTarget[]
  productionRuns                   ProductionRun[]
  machineResponsibilities          MachineResponsibilityAssignment[]

  @@index([code])
  @@index([companyId])
  @@index([branchId])
  @@index([administrationId])
  @@index([departmentId])
  @@index([operationTypeId])
  @@index([costCenterId])
  @@index([status])
  @@index([companyId, status])
  @@map("production_lines")
}

// ── Production Master Data (Phase 1.1) ────────────────────────
model ProductionUnit {
  id           String    @id @default(cuid())
  code         String
  name         String
  abbreviation String?
  description  String?
  decimals     Int       @default(2)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  productionProducts               ProductionProductDefinition[]
  specifications                   ProductionSpecification[]
  packagings                       ProductionPackaging[]
  operationalAssignments           ProductionOperationalAssignment[]
  operationalCostCenterAssignments OperationalCostCenterAssignment[]
  productionOrders                 ProductionOrder[]
  productionMeasurementPoints      ProductionMeasurementPoint[]
  qualityCharacteristics           QualityCharacteristic[]
  performanceTargets               ProductionPerformanceTarget[]
  productionRuns                   ProductionRun[]

  @@unique([companyId, branchId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([companyId, branchId, status])
  @@map("production_units")
}

model ProductionProductDefinition {
  id                  String          @id @default(cuid())
  code                String          @unique
  name                String
  description         String?
  productId           String
  product             Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  defaultUnitId       String?
  defaultUnit         ProductionUnit? @relation(fields: [defaultUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  defaultLineId       String?
  defaultLine         ProductionLine? @relation(fields: [defaultLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  defaultWarehouseId  String?
  defaultWarehouse    Warehouse?      @relation(fields: [defaultWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  defaultCostCenterId String?
  defaultCostCenter   CostCenter?     @relation(fields: [defaultCostCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId            String
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status              String          @default("ACTIVE")
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  specifications        ProductionSpecification[]
  versions              ProductionVersion[]
  packagings            ProductionPackaging[]
  eligibilities         ProductionEligibility[]
  capacityStandards     ProductionCapacityStandard[]
  productionOrders      ProductionOrder[]
  qualityPlans          ProductionQualityPlan[]
  standardCostSnapshots OperationalStandardCostSnapshot[]
  performanceTargets    ProductionPerformanceTarget[]
  productionRuns        ProductionRun[]

  @@index([code])
  @@index([productId])
  @@index([defaultUnitId])
  @@index([defaultLineId])
  @@index([defaultWarehouseId])
  @@index([defaultCostCenterId])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([companyId, branchId, status])
  @@map("production_product_definitions")
}

model ProductionSpecification {
  id                  String                      @id @default(cuid())
  productionProductId String
  productionProduct   ProductionProductDefinition @relation(fields: [productionProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attributeName       String
  attributeValue      String
  dataType            String                      @default("TEXT")
  unitId              String?
  unit                ProductionUnit?             @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isRequired          Boolean                     @default(false)
  sortOrder           Int                         @default(0)
  status              String                      @default("ACTIVE")
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([productionProductId])
  @@index([unitId])
  @@index([status])
  @@map("production_specifications")
}

model ProductionVersion {
  id                    String                            @id @default(cuid())
  productionProductId   String
  productionProduct     ProductionProductDefinition       @relation(fields: [productionProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versionNumber         Int
  versionLabel          String
  description           String?
  isCurrent             Boolean                           @default(false)
  status                String                            @default("ACTIVE")
  createdById           String?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  capacityStandards     ProductionCapacityStandard[]
  productionOrders      ProductionOrder[]
  qualityPlans          ProductionQualityPlan[]
  standardCostSnapshots OperationalStandardCostSnapshot[]
  costTransactions      OperationalCostTransaction[]

  @@unique([productionProductId, versionNumber])
  @@index([productionProductId])
  @@index([status])
  @@map("production_versions")
}

model ProductionPackaging {
  id                    String                            @id @default(cuid())
  productionProductId   String
  productionProduct     ProductionProductDefinition       @relation(fields: [productionProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packagingType         String
  packQuantity          Decimal                           @db.Decimal(18, 4)
  unitId                String?
  unit                  ProductionUnit?                   @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grossWeight           Decimal?                          @db.Decimal(18, 4)
  netWeight             Decimal?                          @db.Decimal(18, 4)
  isDefault             Boolean                           @default(false)
  status                String                            @default("ACTIVE")
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  capacityStandards     ProductionCapacityStandard[]
  productionOrders      ProductionOrder[]
  qualityPlans          ProductionQualityPlan[]
  standardCostSnapshots OperationalStandardCostSnapshot[]
  costTransactions      OperationalCostTransaction[]

  @@index([productionProductId])
  @@index([unitId])
  @@index([status])
  @@map("production_packagings")
}

model ProductionEligibility {
  id                  String                      @id @default(cuid())
  productionProductId String
  productionProduct   ProductionProductDefinition @relation(fields: [productionProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resourceType        String
  machineId           String?
  machine             Machine?                    @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId    String?
  productionLine      ProductionLine?             @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priority            Int                         @default(0)
  isDefault           Boolean                     @default(false)
  notes               String?
  status              String                      @default("ACTIVE")
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([productionProductId, resourceType, machineId])
  @@unique([productionProductId, resourceType, productionLineId])
  @@index([productionProductId])
  @@index([machineId])
  @@index([productionLineId])
  @@index([resourceType])
  @@index([status])
  @@map("production_eligibilities")
}

model ProductionCapacityStandard {
  id                       String                       @id @default(cuid())
  code                     String
  revision                 Int                          @default(1)
  companyId                String
  company                  Company                      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId                 String
  branch                   Branch                       @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionProductId      String
  productionProduct        ProductionProductDefinition  @relation(fields: [productionProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionVersionId      String?
  productionVersion        ProductionVersion?           @relation(fields: [productionVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionPackagingId    String?
  productionPackaging      ProductionPackaging?         @relation(fields: [productionPackagingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId         String
  productionLine           ProductionLine               @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineId                String?
  machine                  Machine?                     @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  standardRate             Decimal                      @db.Decimal(18, 4)
  outputUnit               String
  timeBasis                String
  standardCycleTimeMinutes Decimal?                     @db.Decimal(18, 4)
  setupMinutes             Decimal                      @default(0) @db.Decimal(18, 2)
  changeoverMinutes        Decimal                      @default(0) @db.Decimal(18, 2)
  cleaningMinutes          Decimal                      @default(0) @db.Decimal(18, 2)
  startupAllowanceMinutes  Decimal                      @default(0) @db.Decimal(18, 2)
  shutdownAllowanceMinutes Decimal                      @default(0) @db.Decimal(18, 2)
  targetEfficiencyPercent  Decimal                      @db.Decimal(7, 4)
  expectedYieldPercent     Decimal                      @db.Decimal(7, 4)
  sourceType               String
  sourceReference          String?
  notes                    String?
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  status                   String                       @default("DRAFT")
  supersedesId             String?
  supersedes               ProductionCapacityStandard?  @relation("ProductionCapacityRevisions", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions                ProductionCapacityStandard[] @relation("ProductionCapacityRevisions")
  productionOrders         ProductionOrder[]
  lastMateriallyEditedById String
  createdById              String
  updatedById              String
  approvedById             String?
  approvedAt               DateTime?
  suspendedById            String?
  suspendedAt              DateTime?
  suspensionReason         String?
  archivedById             String?
  archivedAt               DateTime?
  archiveReason            String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  deletedAt                DateTime?

  @@unique([companyId, branchId, code, revision])
  @@index([companyId, branchId, status, effectiveFrom, effectiveTo])
  @@index([companyId, branchId, productionProductId, productionLineId, machineId])
  @@index([productionVersionId])
  @@index([productionPackagingId])
  @@index([supersedesId])
  @@map("production_capacity_standards")
}

// ── Production Orders (Phase 1.4) ────────────────────────────
model ProductionOrder {
  id                               String                      @id @default(cuid())
  companyId                        String
  company                          Company                     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId                         String
  branch                           Branch                      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderNumber                      String
  clientRequestId                  String
  productionProductDefinitionId    String
  productionProductDefinition      ProductionProductDefinition @relation(fields: [productionProductDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionVersionId              String
  productionVersion                ProductionVersion           @relation(fields: [productionVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionPackagingId            String?
  productionPackaging              ProductionPackaging?        @relation(fields: [productionPackagingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionUnitId                 String
  productionUnit                   ProductionUnit              @relation(fields: [productionUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId                 String
  productionLine                   ProductionLine              @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineId                        String?
  machine                          Machine?                    @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plannedQuantity                  Decimal                     @db.Decimal(18, 4)
  quantityUnit                     String
  capacityTimeBasis                String
  plannedStartAt                   DateTime
  plannedEndAt                     DateTime
  priority                         String                      @default("NORMAL")
  sourceType                       String                      @default("MANUAL")
  sourceReference                  String?
  costCenterId                     String
  costCenter                       CostCenter                  @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issueWarehouseId                 String?
  issueWarehouse                   Warehouse?                  @relation("ProductionOrderIssueWarehouse", fields: [issueWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiptWarehouseId               String?
  receiptWarehouse                 Warehouse?                  @relation("ProductionOrderReceiptWarehouse", fields: [receiptWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  capacityStandardId               String
  capacityStandard                 ProductionCapacityStandard  @relation(fields: [capacityStandardId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  capacityStandardCodeSnapshot     String
  capacityStandardRevisionSnapshot Int
  standardRateSnapshot             Decimal                     @db.Decimal(18, 4)
  outputUnitSnapshot               String
  timeBasisSnapshot                String
  standardCycleTimeMinutesSnapshot Decimal?                    @db.Decimal(18, 4)
  setupMinutesSnapshot             Decimal                     @db.Decimal(18, 4)
  changeoverMinutesSnapshot        Decimal                     @db.Decimal(18, 4)
  cleaningMinutesSnapshot          Decimal                     @db.Decimal(18, 4)
  startupAllowanceMinutesSnapshot  Decimal                     @db.Decimal(18, 4)
  shutdownAllowanceMinutesSnapshot Decimal                     @db.Decimal(18, 4)
  targetEfficiencyPercentSnapshot  Decimal                     @db.Decimal(7, 4)
  expectedYieldPercentSnapshot     Decimal                     @db.Decimal(7, 4)
  capacityEffectiveFromSnapshot    DateTime
  capacityEffectiveToSnapshot      DateTime?
  capacityProductIdSnapshot        String
  capacityVersionIdSnapshot        String?
  capacityPackagingIdSnapshot      String?
  capacityLineIdSnapshot           String
  capacityMachineIdSnapshot        String?
  plannedGrossQuantity             Decimal                     @db.Decimal(18, 4)
  plannedRunMinutes                Decimal                     @db.Decimal(18, 4)
  plannedAllowanceMinutes          Decimal                     @db.Decimal(18, 4)
  plannedDurationMinutes           Decimal                     @db.Decimal(18, 4)
  durationCalculationVersion       String                      @default("PHASE_1_4_V1")
  snapshotFrozenAt                 DateTime?
  status                           String                      @default("DRAFT")
  lockVersion                      Int                         @default(0)
  plannedById                      String?
  plannedAt                        DateTime?
  releasedById                     String?
  releasedAt                       DateTime?
  cancelledById                    String?
  cancelledAt                      DateTime?
  cancellationReason               String?
  archivedById                     String?
  archivedAt                       DateTime?
  archiveReason                    String?
  closedById                       String?
  closedAt                         DateTime?
  closureReason                    String?
  notes                            String?
  createdById                      String
  updatedById                      String
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt
  deletedAt                        DateTime?

  runs                  ProductionRun[]
  transitions           ProductionOrderTransition[]
  attachments           ProductionOrderAttachment[]
  downtimeLogs          DowntimeLog[]
  downtimeSegments      DowntimeSegment[]
  lossQuantityEvents    ProductionLossQuantityEvent[]
  materialDocuments     ProductionMaterialDocument[]
  finishedGoodsReceipts ProductionFinishedGoodsReceipt[]
  materialRequirements  ProductionMaterialRequirement[]
  materialConsumptions  ProductionMaterialConsumption[]
  inspections           ProductionInspection[]
  costTransactions      OperationalCostTransaction[]
  costCalculations      OperationalCostCalculation[]

  @@unique([companyId, branchId, orderNumber])
  @@unique([companyId, branchId, clientRequestId])
  @@index([companyId, branchId, status, plannedStartAt, plannedEndAt])
  @@index([companyId, branchId, productionProductDefinitionId])
  @@index([companyId, branchId, productionLineId, machineId, plannedStartAt, plannedEndAt])
  @@index([companyId, branchId, sourceType, sourceReference])
  @@index([productionVersionId])
  @@index([productionPackagingId])
  @@index([productionUnitId])
  @@index([costCenterId])
  @@index([issueWarehouseId])
  @@index([receiptWarehouseId])
  @@index([capacityStandardId])
  @@map("production_orders")
}

model ProductionOrderTransition {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId          String
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
