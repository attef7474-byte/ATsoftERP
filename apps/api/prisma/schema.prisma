  /// source document. Immutable once created; the original document is never mutated.
  reversesDocumentId String?
  reversesDocument   ProductionMaterialDocument?  @relation("ProductionMaterialDocumentReversal", fields: [reversesDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
