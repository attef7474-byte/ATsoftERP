model DowntimeLog {
  id                     String              @id @default(cuid())
  machineId              String
  machine                Machine             @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId              String?
  request                MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startTime              DateTime
  endTime                DateTime?
  durationMinutes        Float?
  reason                 String
  failureCause           String?
  failureCategory        String?
  rootCause              String?
  correctiveAction       String?
  preventiveAction       String?
  detectedAt             DateTime?
  responseStartedAt      DateTime?
  repairStartedAt        DateTime?
  repairCompletedAt      DateTime?
  isRepeatFailure        Boolean?
  repeatedFailureGroupId String?
  machineStopped         Boolean?
  productionImpact       String?
  rcaStatus              String?             @default("PENDING")
  rcaCompletedByUserId   String?
  rcaCompletedBy         User?               @relation(fields: [rcaCompletedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rcaCompletedAt         DateTime?
  notes                  String?
  cancelledAt            DateTime?
  // ── Phase 1.6 production-loss extension (additive, nullable until backfill) ──
  companyId              String?
  branchId               String?
  productionRunId        String?
  productionRun          ProductionRun?      @relation(fields: [productionRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionOrderId      String?
  productionOrder        ProductionOrder?    @relation(fields: [productionOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId       String?
  productionLine         ProductionLine?     @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftId                String?
  shift                  ProductionShift?    @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  occurrenceType         String?
  severity               String?
  sourceType             String              @default("MAINTENANCE")
  status                 String              @default("OPEN")
  correctsLogId          String?
  correctsLog            DowntimeLog?        @relation("DowntimeLogCorrection", fields: [correctsLogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  corrections            DowntimeLog[]       @relation("DowntimeLogCorrection")
  correctionReason       String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  requiredParts MaintenanceRequestRequiredPart[]
  segments      DowntimeSegment[]

  @@index([machineId])
  @@index([requestId])
  @@index([startTime])
  @@index([machineId, startTime])
  @@index([requestId, cancelledAt])
  @@index([endTime, cancelledAt])
  @@index([failureCategory])
  @@index([rcaStatus])
  @@index([companyId, branchId, startTime])
  @@index([productionRunId])
  @@index([productionOrderId])
  @@index([productionLineId])
  @@index([shiftId])
  @@index([status])
  @@index([correctsLogId])
  @@map("downtime_logs")
}

