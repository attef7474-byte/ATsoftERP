  postedById     String?
  cancelledById  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  /// Set on a compensating movement that reverses another movement. The original movement is never deleted.
  reversesMovementId String?
  reversesMovement   InventoryMovement?  @relation("MovementReversal", fields: [reversesMovementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalMovements  InventoryMovement[] @relation("MovementReversal")

