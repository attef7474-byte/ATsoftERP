// VAL-R1G-A: immutable production-run cost boundary snapshot.
//
// One row per ProductionRun. It is the AUTHORITATIVE source of record proving
// the run's material cost was frozen at a point in time. It is immutable after
// creation (no update/delete endpoint) and never alters physical inventory.
//
// costBasis is always NET_ACTUAL_MATERIAL_VALUE_ONLY for this slice — meaning
// only R1F valued production materials (ISSUE + CONSUMPTION, net of trusted
// RETURN) are capitalized. Labor, energy, maintenance, overhead, and
// OperationalCostTransaction are DEFERRED_NOT_CAPITALIZED (outside boundary).
//
// netMaterialValue is the exact sum of immutable R1F InventoryMovementLine
// totalCost snapshots for OUT events minus trusted RETURN totalCost snapshots.
// finalGoodQuantity is the authoritative GOOD output at close time (from
// deriveRunTotals on authoritative measurement points, net of corrections).
//
// The DB-level unique (companyId, branchId, productionRunId) is the idempotency
// guard: a second cost close for the same run is rejected rather than silently
// overwritten. Currency must exactly equal the ACTIVE valuation policy currency.
model ProductionRunCostSnapshot {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionRunId String        @unique
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finalProductId  String
  finalProduct    Product       @relation(fields: [finalProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  finalGoodQuantity Decimal @db.Decimal(18, 4)
  netMaterialValue  Decimal @db.Decimal(19, 4)
  currencyCode      String
  costBasis         String  @default("NET_ACTUAL_MATERIAL_VALUE_ONLY")

  closedAt    DateTime @default(now())
  closedById  String?
  createdById String?

  createdAt DateTime @default(now())

  @@unique([companyId, branchId, productionRunId])
  @@index([companyId, branchId])
  @@index([productionRunId])
  @@index([finalProductId])
  @@map("production_run_cost_snapshots")
}

