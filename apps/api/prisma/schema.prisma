  @@index([companyId, branchId, productionOrderId, createdAt])
  @@index([attachmentId])
  @@map("production_order_attachments")
}

// ── Production Shift & Operational Assignments (Phase 1.2) ──────
model ProductionShift {
  id              String    @id @default(cuid())
  code            String
  name            String
  description     String?
  startTime       String
  endTime         String
  durationMinutes Int       @default(480)
  breakMinutes    Int       @default(0)
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  templateDays           ProductionShiftTemplateDay[]
  calendarEntries        ProductionShiftCalendarEntry[]
  shiftAssignments       ProductionShiftAssignment[]
  operationalAssignments ProductionOperationalAssignment[]
  downtimeLogs           DowntimeLog[]
  downtimeSegments       DowntimeSegment[]
  inspections            ProductionInspection[]
  costTransactions       OperationalCostTransaction[]
  outgoingHandovers      ShiftHandover[]                   @relation("OutgoingShift")
  incomingHandovers      ShiftHandover[]                   @relation("IncomingShift")

  @@unique([companyId, branchId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([companyId, branchId, status])
  @@map("production_shifts")
}

model ProductionShiftTemplate {
  id          String    @id @default(cuid())
  code        String
  name        String
  description String?
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  days      ProductionShiftTemplateDay[]
  calendars ProductionShiftCalendar[]

  @@unique([companyId, branchId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([companyId, branchId, status])
  @@map("production_shift_templates")
}

model ProductionShiftTemplateDay {
  id         String                  @id @default(cuid())
  templateId String
  template   ProductionShiftTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dayOfWeek  Int
  shiftId    String
  shift      ProductionShift         @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isWorkDay  Boolean                 @default(true)
  sortOrder  Int                     @default(0)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([templateId, dayOfWeek])
  @@index([templateId])
  @@index([shiftId])
  @@map("production_shift_template_days")
}

model ProductionShiftCalendar {
  id            String                   @id @default(cuid())
  code          String
  name          String
  description   String?
  templateId    String?
  template      ProductionShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId     String
  company       Company                  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId      String
  branch        Branch                   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String                   @default("ACTIVE")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?

  entries          ProductionShiftCalendarEntry[]
  shiftAssignments ProductionShiftAssignment[]

  @@unique([companyId, branchId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([templateId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([status])
  @@index([companyId, branchId, status])
  @@map("production_shift_calendars")
}

model ProductionShiftCalendarEntry {
  id         String                  @id @default(cuid())
  calendarId String
  calendar   ProductionShiftCalendar @relation(fields: [calendarId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date       DateTime
  shiftId    String?
  shift      ProductionShift?        @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isWorkDay  Boolean                 @default(true)
  notes      String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([calendarId, date])
  @@index([calendarId])
  @@index([shiftId])
  @@map("production_shift_calendar_entries")
}

model ProductionShiftAssignment {
  id                  String                   @id @default(cuid())
  code                String
  shiftId             String
  shift               ProductionShift          @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calendarId          String?
  calendar            ProductionShiftCalendar? @relation(fields: [calendarId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  operationalPersonId String
  operationalPerson   OperationalPerson        @relation(fields: [operationalPersonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  isPrimary           Boolean                  @default(false)
  notes               String?
  companyId           String
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId            String
  branch              Branch                   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status              String                   @default("ACTIVE")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?

  @@unique([code])
  @@index([shiftId])
  @@index([calendarId])
  @@index([operationalPersonId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([companyId, branchId, status])
  @@index([operationalPersonId, shiftId, effectiveFrom, effectiveTo])
  @@map("production_shift_assignments")
}

model ProductionOperationalAssignment {
  id               String           @id @default(cuid())
  code             String
  resourceType     String
  machineId        String?
  machine          Machine?         @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionLineId String?
  productionLine   ProductionLine?  @relation(fields: [productionLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionUnitId String?
  productionUnit   ProductionUnit?  @relation(fields: [productionUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
