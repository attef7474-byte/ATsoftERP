// ── Maintenance Work Order ─────────────────────────────────────
// Phase 0 slice: links maintenance to inventory (parts issue) and cost
// with full tenant isolation. Status lifecycle:
// DRAFT -> PLANNED -> IN_PROGRESS -> COMPLETED  |  -> CANCELLED
model MaintenanceWorkOrder {
  id                 String              @id @default(cuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId           String
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrderNumber    String
  title              String
  description        String?
  type               String              @default("CORRECTIVE")
  priority           String              @default("MEDIUM")
  status             String              @default("DRAFT")
  machineId          String?
  machine            Machine?            @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machineComponentId String?
  machineComponent   MachineComponent?   @relation(fields: [machineComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId          String?
  request            MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouseId        String?
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedToId       String?
  assignedTo         User?               @relation("MaintenanceWorkOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supervisorId       String?
  supervisor         User?               @relation("MaintenanceWorkOrderSupervisedBy", fields: [supervisorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById        String?
  createdBy          User?               @relation("MaintenanceWorkOrderCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plannedStartAt     DateTime?
  plannedEndAt       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  estimatedCost      Decimal?            @db.Decimal(18, 2)
  actualCost         Decimal?            @db.Decimal(18, 2)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  parts            MaintenanceWorkOrderPart[]
  costEntries      MaintenanceWorkOrderCostEntry[]
  downtimeSegments DowntimeSegment[]

  @@unique([branchId, workOrderNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([machineId])
  @@index([machineComponentId])
  @@index([requestId])
  @@index([assignedToId])
  @@index([supervisorId])
  @@index([createdById])
  @@index([companyId, status])
  @@index([branchId, status])
  @@index([branchId, status, priority])
  @@index([createdAt])
  @@map("maintenance_work_orders")
}

