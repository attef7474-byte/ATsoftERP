  oldSparePartId         String?                         @map("old_spare_part_id")
  oldSparePart           SparePart?                      @relation("OldSparePart", fields: [oldSparePartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newSparePartId         String                          @map("new_spare_part_id")
  newSparePart           SparePart                       @relation("NewSparePart", fields: [newSparePartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issuedCondition        String                          @map("issued_condition")
  issuedQuantity         Float                           @map("issued_quantity")
  removedCondition       String?                         @map("removed_condition")
  removedQuantity        Float?                          @map("removed_quantity")
