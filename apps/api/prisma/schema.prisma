  requestedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  reservedAt        DateTime?
  usedAt            DateTime?
  cancelledAt       DateTime?

  // Batch O — maintenance stock issue fields (backward compatible, all nullable)
